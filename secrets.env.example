# Supabase Connection
# IMPORTANT: When using the Supabase Pooler, the username MUST be in the format:
#   postgres.{your_project_ref}
# Example: postgres.oymlddjcusiyaxtfcvad
# You can find your project ref in the Supabase dashboard URL or connection string.
SUPABASE_USER=postgres.your_project_ref_here
SUPABASE_PASSWORD=your_supabase_password_here
SUPABASE_HOST=aws-1-eu-central-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres

# BigQuery Configuration
BIGQUERY_PROJECT_ID=your_gcp_project_id
BIGQUERY_CREDENTIALS_FILE=google_creds.json

# Tables to sync (comma-separated, optional)
# If left empty, all tables in the public schema will be synced automatically
TABLES_TO_SYNC=
